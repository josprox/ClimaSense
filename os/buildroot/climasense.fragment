BR2_INIT_BUSYBOX=y
BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="climasense"
BR2_TARGET_GENERIC_ISSUE="ClimaSense OS 0.1.0"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_ROOTFS_OVERLAY="board/climasense/rootfs-overlay"
BR2_ROOTFS_USERS_TABLES="board/climasense/users.txt"
BR2_ROOTFS_DEVICE_TABLE="system/device_table_dev.txt board/climasense/device_table.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/climasense/post-build.sh"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/climasense/kernel.fragment"
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_RNG_TOOLS=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="board/climasense/config.txt"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
