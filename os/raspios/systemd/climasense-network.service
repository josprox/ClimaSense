[Unit]
Description=ClimaSense Wi-Fi client
After=climasense-onboarding.service
OnFailure=climasense-network-recovery.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/climasense/network
ExecStop=/usr/local/lib/climasense/network stop
RemainAfterExit=yes
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
