class TelemetryQueue {
    func initialize(string $path) {
        $db = new SQLite()
        $opened = $db->open($path)
        ($opened == false) ? { throw "No se pudo abrir la cola SQLite" } : {}
        $db->query("PRAGMA journal_mode=WAL")
        $db->query("PRAGMA synchronous=FULL")
        $db->query("CREATE TABLE IF NOT EXISTS telemetry_queue (sequence INTEGER PRIMARY KEY, payload TEXT NOT NULL, created_at TEXT NOT NULL)")
        $db->query("CREATE TABLE IF NOT EXISTS telemetry_meta (key TEXT PRIMARY KEY, value INTEGER)")
        $db->close()
        return true
    }

    func nextSequence(string $path) {
        $db = new SQLite()
        $db->open($path)
        $db->query("CREATE TABLE IF NOT EXISTS telemetry_meta (key TEXT PRIMARY KEY, value INTEGER)")
        $rows = $db->query("SELECT value FROM telemetry_meta WHERE key = 'last_sequence'")
        $next = 1
        (count($rows) > 0) ? {
            $val = $rows[0]["value"]
            (empty($val) == false && $val > 0) ? {
                $next = $val + 1
            } : {}
        } : {
            $max_queue = $db->query("SELECT MAX(sequence) AS max_seq FROM telemetry_queue")
            (count($max_queue) > 0 && empty($max_queue[0]["max_seq"]) == false && $max_queue[0]["max_seq"] > 0) ? {
                $next = $max_queue[0]["max_seq"] + 1
            } : {}
        }
        $db->query("INSERT OR REPLACE INTO telemetry_meta(key, value) VALUES ('last_sequence', ?)", [$next])
        $db->close()
        return $next
    }

    func enqueue(string $path, int $sequence, $payload, int $maximum) {
        $db = new SQLite()
        $db->open($path)
        $db->query("CREATE TABLE IF NOT EXISTS telemetry_meta (key TEXT PRIMARY KEY, value INTEGER)")
        $db->query("INSERT OR IGNORE INTO telemetry_queue(sequence, payload, created_at) VALUES (?, ?, ?)", [$sequence, JSON::stringify($payload), System::now()])
        $db->query("DELETE FROM telemetry_queue WHERE sequence IN (SELECT sequence FROM telemetry_queue ORDER BY sequence ASC LIMIT MAX((SELECT COUNT(*) FROM telemetry_queue) - ?, 0))", [$maximum])
        $rows = $db->query("SELECT value FROM telemetry_meta WHERE key = 'last_sequence'")
        $current = 0
        (count($rows) > 0 && empty($rows[0]["value"]) == false) ? { $current = $rows[0]["value"] } : {}
        ($sequence > $current) ? {
            $db->query("INSERT OR REPLACE INTO telemetry_meta(key, value) VALUES ('last_sequence', ?)", [$sequence])
        } : {}
        $db->close()
        return true
    }

    func pending(string $path, int $limit) {
        $db = new SQLite()
        $db->open($path)
        $rows = $db->query("SELECT sequence, payload FROM telemetry_queue ORDER BY sequence ASC LIMIT ?", [$limit])
        $db->close()

        $result = []
        foreach ($rows as $row) {
            $payload = JSON::parse($row["payload"])
            $result = append($result, {"sequence": $row["sequence"], "payload": $payload})
        }
        return $result
    }

    func acknowledge(string $path, int $through_sequence) {
        $db = new SQLite()
        $db->open($path)
        $db->query("DELETE FROM telemetry_queue WHERE sequence <= ?", [$through_sequence])
        $db->close()
        return true
    }

    func purgeStale(string $path, int $max_age_seconds) {
        $db = new SQLite()
        $db->open($path)
        $db->query("DELETE FROM telemetry_queue WHERE created_at < DATETIME('now', '-' || ? || ' seconds')", [$max_age_seconds])
        $db->close()
        return true
    }

    func count(string $path) {
        $db = new SQLite()
        $db->open($path)
        $rows = $db->query("SELECT COUNT(*) AS pending FROM telemetry_queue")
        $db->close()
        return $rows[0]["pending"]
    }
}
