class OnboardingController {
    func index() {
        $server_url = System::env("SERVER_BASE_URL", "http://127.0.0.1:8080")
        return View::render("onboarding", {"server_url": $server_url})
    }

    func setupStatus() {
        $data_dir = System::env("CLIMASENSE_DATA_DIR", "/data/climasense")
        $activated = false
        $token_path = System::env("DEVICE_TOKEN_FILE", $data_dir . "/device.token")
        $token = Str::trim(file_get_contents($token_path))
        (empty($token) == false) ? {
            $activated = true
        } : {}

        $ap_ssid = "ClimaSense Mantenimiento"
        $saved_ssid = Str::trim(file_get_contents($data_dir . "/maintenance-ap.ssid"))
        (empty($saved_ssid) == false) ? { $ap_ssid = $saved_ssid } : {}
        $hostapd_config = Str::trim(file_get_contents($data_dir . "/hostapd.conf"))

        return ApiResponse::json({
            "ok": true,
            "activated": $activated,
            "maintenance_ap_configured": empty($hostapd_config) == false,
            "maintenance_ap_ssid": $ap_ssid
        }, 200)
    }

    func scanWifi() {
        $networks = []
        try {
            $output = System::Run("/bin/sh", ["-c", "iface=$(cat /run/climasense-wifi.interface 2>/dev/null); { cat /data/climasense/wifi.scan 2>/dev/null; [ -n \"$iface\" ] && iw dev \"$iface\" scan 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p'; } | awk 'NF && !seen[$0]++'"])
            $lines = explode("\n", $output)
            foreach ($lines as $line) {
                $ssid = Str::trim($line)
                (empty($ssid) == false) ? {
                    $networks = append($networks, {"ssid": $ssid, "signal": "Detectada"})
                } : {}
            }
        } catch ($e) {}

        return ApiResponse::json({"ok": true, "networks": $networks}, 200)
    }

    func connectWifi() {
        $data_dir = System::env("CLIMASENSE_DATA_DIR", "/data/climasense")
        $ssid = Str::trim(Request::input("ssid", ""))
        $password = Request::input("password", "")
        (empty($ssid) == true) ? { return ApiResponse::error("El SSID es obligatorio", 422) } : {}
        (Str::length($ssid) > 32) ? { return ApiResponse::error("El SSID no puede exceder 32 caracteres", 422) } : {}
        (Str::contains($ssid, "\n") || Str::contains($ssid, "\r") || Str::contains($password, "\n") || Str::contains($password, "\r")) ? {
            return ApiResponse::error("El SSID y la contrasena no pueden contener saltos de linea", 422)
        } : {}
        (Str::length($password) < 8 || Str::length($password) > 63) ? {
            return ApiResponse::error("La contrasena Wi-Fi debe tener entre 8 y 63 caracteres", 422)
        } : {}

        $generated_network = System::Run("wpa_passphrase", [$ssid, $password])
        (empty($generated_network) == true) ? {
            return ApiResponse::error("No se pudo proteger la configuracion Wi-Fi", 500)
        } : {}

        $wpa_conf = "ctrl_interface=/run/wpa_supplicant\nupdate_config=0\ncountry=MX\n\n"
        $network_lines = explode("\n", $generated_network)
        foreach ($network_lines as $network_line) {
            (Str::contains($network_line, "#psk=") == false) ? {
                $wpa_conf = $wpa_conf . $network_line . "\n"
            } : {}
        }
        $wifi_path = $data_dir . "/wpa_supplicant.conf"
        file_put_contents($wifi_path, $wpa_conf)
        System::Run("chmod", ["0600", $wifi_path])

        return ApiResponse::json({"ok": true, "message": "Wi-Fi guardado. Ingrese ahora el codigo de activacion."}, 200)
    }


    func completeSetup() {
        $data_dir = System::env("CLIMASENSE_DATA_DIR", "/data/climasense")
        $code = Str::trim(Request::input("code", ""))
        $ap_ssid = Str::trim(Request::input("ap_ssid", ""))
        $ap_pass = Request::input("ap_pass", "")
        $wifi_config = Str::trim(file_get_contents($data_dir . "/wpa_supplicant.conf"))
        (empty($wifi_config) == true) ? {
            return ApiResponse::error("Primero configure la red Wi-Fi", 409)
        } : {}

        $token_path = System::env("DEVICE_TOKEN_FILE", $data_dir . "/device.token")
        $activated = false
        $token = Str::trim(file_get_contents($token_path))
        (empty($token) == false) ? {
            $activated = true
        } : {}

        (empty($ap_ssid) == true) ? {
            $ap_ssid = Str::trim(file_get_contents($data_dir . "/maintenance-ap.ssid"))
        } : {}
        (empty($ap_pass) == true) ? {
            $ap_pass = file_get_contents($data_dir . "/maintenance-ap.pass")
        } : {}

        (empty($ap_ssid) == true) ? { return ApiResponse::error("El nombre del hotspot es obligatorio", 422) } : {}
        (Str::length($ap_ssid) > 32) ? { return ApiResponse::error("El nombre del hotspot no puede exceder 32 caracteres", 422) } : {}
        (empty($ap_pass) == true) ? { return ApiResponse::error("La contrasena del hotspot es obligatoria", 422) } : {}
        (Str::length($ap_pass) < 8 || Str::length($ap_pass) > 63) ? {
            return ApiResponse::error("La contrasena del hotspot debe tener entre 8 y 63 caracteres", 422)
        } : {}
        (Str::contains($ap_ssid, "\n") || Str::contains($ap_ssid, "\r") || Str::contains($ap_pass, "\n") || Str::contains($ap_pass, "\r")) ? {
            return ApiResponse::error("El nombre y la contrasena no pueden contener saltos de linea", 422)
        } : {}
        ($activated == false && empty($code) == true) ? {
            return ApiResponse::error("El codigo de activacion es obligatorio", 422)
        } : {}
        (Str::length($code) > 128 || Str::contains($code, "\n") || Str::contains($code, "\r")) ? {
            return ApiResponse::error("El codigo de activacion no es valido", 422)
        } : {}

        $hostapd_conf = "driver=nl80211\ncountry_code=MX\nssid=" . $ap_ssid . "\nhw_mode=g\nchannel=6\nmacaddr_acl=0\nauth_algs=1\nignore_broadcast_ssid=0\nwpa=2\nwpa_passphrase=" . $ap_pass . "\nwpa_key_mgmt=WPA-PSK\nrsn_pairwise=CCMP\n"

        $hostapd_path = $data_dir . "/hostapd.conf"
        $maintenance_ssid_path = $data_dir . "/maintenance-ap.ssid"
        $maintenance_pass_path = $data_dir . "/maintenance-ap.pass"
        file_put_contents($hostapd_path, $hostapd_conf)
        file_put_contents($maintenance_ssid_path, $ap_ssid . "\n")
        file_put_contents($maintenance_pass_path, $ap_pass)
        System::Run("chmod", ["0600", $hostapd_path, $maintenance_ssid_path, $maintenance_pass_path])

        ($activated == true) ? {
            $maintenance_complete_path = $data_dir . "/maintenance.complete"
            file_put_contents($maintenance_complete_path, "1\n")
            System::Run("chmod", ["0600", $maintenance_complete_path])
        } : {
            $activation_path = $data_dir . "/activation.code"
            file_put_contents($activation_path, $code . "\n")
            System::Run("chmod", ["0600", $activation_path])
        }

        return ApiResponse::json({
            "ok": true,
            "maintenance": $activated,
            "message": "Configuracion guardada. El hotspot se apagara y el equipo volvera a conectarse."
        }, 202)
    }
}
