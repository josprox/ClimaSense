class OnboardingController {
    func index() {
        $server_url = System::env("SERVER_BASE_URL", "http://127.0.0.1:8080")
        return View::render("onboarding", {"server_url": $server_url})
    }

    func scanWifi() {
        $networks = []
        try {
            $output = System::exec("wpa_cli -i wlan0 scan_results 2>/dev/null || iwlist wlan0 scan 2>/dev/null")
            $lines = Str::split($output, "\n")
            foreach ($lines as $line) {
                (strings::contains($line, "ESSID:") == true) ? {
                    $parts = Str::split($line, "ESSID:\"")
                    (count($parts) >= 2) ? {
                        $ssid = Str::replace($parts[1], "\"", "")
                        (empty($ssid) == false) ? {
                            $networks = append($networks, {"ssid": $ssid, "signal": "Excelente"})
                        } : {}
                    } : {}
                } : {}
            }
        } catch ($e) {}

        (count($networks) == 0) ? {
            $networks = [
                {"ssid": "Wi-Fi Oficina Principal", "signal": "Fuerte"},
                {"ssid": "Wi-Fi Servidores", "signal": "Excelente"}
            ]
        } : {}

        return ApiResponse::json({"ok": true, "networks": $networks}, 200)
    }

    func connectWifi() {
        $ssid = Request::input("ssid", "")
        $password = Request::input("password", "")
        (empty($ssid) == true) ? { return ApiResponse::error("El SSID es obligatorio", 422) } : {}

        $env_path = System::env("CLIMASENSE_ENV_FILE", "/data/climasense/.env")
        $existing_env = file_get_contents($env_path)
        (empty($existing_env) == true) ? { $existing_env = "" } : {}

        $updated_env = $existing_env . "\nWIFI_SSID=\"" . $ssid . "\"\nWIFI_PASSWORD=\"" . $password . "\"\n"
        file_put_contents($env_path, $updated_env)

        try {
            System::exec("wpa_cli -i wlan0 add_network 2>/dev/null")
            System::exec("wpa_cli -i wlan0 set_network 0 ssid '\"" . $ssid . "\"' 2>/dev/null")
            System::exec("wpa_cli -i wlan0 set_network 0 psk '\"" . $password . "\"' 2>/dev/null")
            System::exec("wpa_cli -i wlan0 select_network 0 2>/dev/null")
        } catch ($e) {}

        return ApiResponse::json({"ok": true, "message": "Wi-Fi configurado correctamente"}, 200)
    }

    func activateDevice() {
        $code = Request::input("code", "")
        $server_url = Request::input("server_url", System::env("SERVER_BASE_URL", "http://127.0.0.1:8080"))
        (empty($code) == true) ? { return ApiResponse::error("El codigo de activacion es obligatorio", 422) } : {}

        $hardware_id = System::env("CLIMASENSE_HARDWARE_ID", System::env("HARDWARE_ID", ""))
        (empty($hardware_id) == true && file_exists("/sys/class/net/wlan0/address") == true) ? {
            $hardware_id = "rpi-wlan-" . trim(file_get_contents("/sys/class/net/wlan0/address"))
        } : {}
        empty($hardware_id) ? { $hardware_id = "rpi-edge-" . System::now() } : {}

        $device_name = System::env("DEVICE_NAME", "ClimaSense Edge")
        $activation_path = System::env("SERVER_ACTIVATION_PATH", "/api/v1/edge/activate")

        $res = ClimaSenseTransport::activate($server_url, $activation_path, $code, $hardware_id, $device_name, "15")
        ($res["ok"] == true) ? {} : { return ApiResponse::error("El servidor rechazo la activacion", 400) }

        $token_path = System::env("DEVICE_TOKEN_FILE", "/data/climasense/device.token")
        file_put_contents($token_path, $res["device_token"])

        $env_path = System::env("CLIMASENSE_ENV_FILE", "/data/climasense/.env")
        $existing_env = file_get_contents($env_path)
        (empty($existing_env) == true) ? { $existing_env = "" } : {}

        $updated_env = $existing_env . "\nDEVICE_ID=\"" . $res["device_id"] . "\"\nHARDWARE_ID=\"" . $hardware_id . "\"\nSERVER_BASE_URL=\"" . $server_url . "\"\n"
        file_put_contents($env_path, $updated_env)

        return ApiResponse::json({"ok": true, "device_id": $res["device_id"]}, 200)
    }

    func configAP() {
        $ap_ssid = Request::input("ap_ssid", "Configuración ClimaSense")
        $ap_pass = Request::input("ap_pass", "climasense123")

        $env_path = System::env("CLIMASENSE_ENV_FILE", "/data/climasense/.env")
        $existing_env = file_get_contents($env_path)
        (empty($existing_env) == true) ? { $existing_env = "" } : {}

        $updated_env = $existing_env . "\nFALLBACK_AP_SSID=\"" . $ap_ssid . "\"\nFALLBACK_AP_PASS=\"" . $ap_pass . "\"\nONBOARDING_COMPLETED=\"true\"\n"
        file_put_contents($env_path, $updated_env)

        return ApiResponse::json({"ok": true, "message": "Punto de acceso de mantenimiento configurado"}, 200)
    }
}
