$devices = GranDB::table("devices")->count()
$credentials = GranDB::table("device_credentials")->count()
$configurations = GranDB::table("device_configurations")->count()
$measurements = GranDB::table("telemetry_measurements")->count()
$heartbeats = GranDB::table("device_heartbeats")->count()
$releases = GranDB::table("firmware_releases")->count()
$updates = GranDB::table("device_update_status")->count()
$events = GranDB::table("security_events")->count()
$organizations = GranDB::table("organizations")->count()
$organization_users = GranDB::table("organization_users")->count()
$locations = GranDB::table("locations")->count()
$activation_codes = GranDB::table("activation_codes")->count()
$weather_snapshots = GranDB::table("weather_snapshots")->count()
$environmental_analyses = GranDB::table("environmental_analyses")->count()

print(JSON::stringify({
    "devices": $devices,
    "credentials": $credentials,
    "configurations": $configurations,
    "measurements": $measurements,
    "heartbeats": $heartbeats,
    "releases": $releases,
    "updates": $updates,
    "events": $events,
    "organizations": $organizations,
    "organization_users": $organization_users,
    "locations": $locations,
    "activation_codes": $activation_codes,
    "weather_snapshots": $weather_snapshots,
    "environmental_analyses": $environmental_analyses
}))
print("database-ready-ok")
