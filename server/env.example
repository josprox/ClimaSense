APP_ENV="development"
PORT="8080"
DB="postgres"
DB_HOST="127.0.0.1:5432"
DB_NAME="climasense"
DB_USER="climasense"
DB_PASS="replace-outside-repository"
DB_SSLMODE="disable"
PREFIX="cs_"
PROVISIONING_KEY_HASH="sha256-created-with-climasense-transport"
OPERATOR_TOKEN_HASH="sha256-created-with-climasense-transport"
SAAS_BOOTSTRAP_KEY="replace-with-a-one-time-random-bootstrap-key"
SESSION_DRIVER="file"
SESSION_FILE="storage/sessions.json"
SESSION_COOKIE_SECURE="true"
RATE_LIMIT_REQUESTS="120"
RATE_LIMIT_WINDOW_SECONDS="60"
PLUGIN_TIMEOUT_SECONDS="20"
