class SaaSAuthController {
    func secureCookieSuffix() {
        $configured = System::env("SESSION_COOKIE_SECURE", "true")
        return ($configured == "true" || $configured == "TRUE" || $configured == "1") ? "; Secure" : ""
    }

    func loginPage() {
        $token = Request::cookie("joss_token")
        (empty($token) == true) ? { return View::render("saas.login", {"title": "Acceso a ClimaSense"}) } : {}
        (Auth::check() == true) ? {
            $dest = (Auth::hasRole("admin") == true) ? "/admin" : "/app"
            return Response::redirect($dest)
        } : {}
        return View::render("saas.login", {"title": "Acceso a ClimaSense"})
    }

    func registerPage() {
        $token = Request::cookie("joss_token")
        (empty($token) == true) ? { return View::render("saas.register", {"title": "Registro de Cliente — ClimaSense"}) } : {}
        (Auth::check() == true) ? {
            $dest = (Auth::hasRole("admin") == true) ? "/admin" : "/app"
            return Response::redirect($dest)
        } : {}
        return View::render("saas.register", {"title": "Registro de Cliente — ClimaSense"})
    }

    func register() {
        $email = Request::input("email", "")
        $password = Request::input("password", "")
        $name = Request::input("name", "Cliente")
        (empty($email) || empty($password)) ? { return ApiResponse::error("Correo y contrasena son obligatorios", 422) } : {}

        $existing = GranDB::table("users")->where("email", $email)->first()
        empty($existing) ? {} : { return ApiResponse::error("El correo electronico ya esta registrado", 409) }

        $created = Auth::create({"username": $email, "first_name": $name, "last_name": "", "email": $email, "password": $password, "phone": "", "role_id": 2})
        ($created == false) ? { return ApiResponse::error("No se pudo crear la cuenta de usuario", 500) } : {}
        GranDB::table("users")->where("email", $email)->update({"verificado": 1, "updated_at": System::now()})

        $token = Auth::attempt($email, $password)
        $cookieHeader = "joss_token=" . $token . "; Path=/; HttpOnly; SameSite=Lax" . SaaSAuthController::secureCookieSuffix()
        return ApiResponse::json({"ok": true, "message": "Cuenta creada con exito", "redirect": "/app"}, 201)->withHeader("Set-Cookie", $cookieHeader)
    }

    func setupPage() {
        return View::render("saas.setup", {"title": "Configurar administrador"})
    }

    func login() {
        $email = Request::input("email", "")
        $password = Request::input("password", "")
        (empty($email) || empty($password)) ? { return ApiResponse::error("Correo y contrasena son obligatorios", 422) } : {}
        $token = Auth::attempt($email, $password)
        ($token == false) ? { return ApiResponse::error("Credenciales invalidas", 401) } : {}
        $destination = (Auth::hasRole("admin") == true) ? "/admin" : "/app"
        $cookieHeader = "joss_token=" . $token . "; Path=/; HttpOnly; SameSite=Lax" . SaaSAuthController::secureCookieSuffix()
        return ApiResponse::json({"ok": true, "redirect": $destination}, 200)->withHeader("Set-Cookie", $cookieHeader)
    }

    func logout() {
        Auth::logout()
        $cookieHeader = "joss_token=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0" . SaaSAuthController::secureCookieSuffix()
        return ApiResponse::json({"ok": true, "redirect": "/login"}, 200)->withHeader("Set-Cookie", $cookieHeader)
    }

    func websocketToken() {
        try { SaaSAuth::userId() } catch ($error) { return ApiResponse::error("Sesion requerida", 401) }
        $token = Request::cookie("joss_token")
        (empty($token) == true) ? { return ApiResponse::error("Sesion WebSocket no disponible", 401) } : {}
        return ApiResponse::json({"ok": true, "token": $token}, 200)->withHeader("Cache-Control", "no-store, private")
    }

    func bootstrapAdmin() {
        $provided = Request::input("bootstrap_key", "")
        $expected = System::env("SAAS_BOOTSTRAP_KEY", System::env("APP_KEY", ""))
        empty($expected) ? { return ApiResponse::error("Bootstrap deshabilitado", 503) } : {}
        (ClimaSenseTransport::secureEqual($provided, $expected) == true) ? {} : { return ApiResponse::error("Clave de bootstrap invalida", 401) }
        $existing = GranDB::table("users")->where("role_id", 1)->count()
        ($existing == 0) ? {} : { return ApiResponse::error("Ya existe un administrador", 409) }

        $email = Request::input("email", "")
        $password = Request::input("password", "")
        $name = Request::input("name", "Administrador")
        (empty($email) || empty($password)) ? { return ApiResponse::error("Correo y contrasena son obligatorios", 422) } : {}
        $created = Auth::create({"username": $email, "first_name": $name, "last_name": "", "email": $email, "password": $password, "phone": "", "role_id": 1})
        ($created == false) ? { return ApiResponse::error("No se pudo crear el administrador", 409) } : {}
        GranDB::table("users")->where("email", $email)->update({"verificado": 1, "updated_at": System::now()})
        return ApiResponse::json({"ok": true, "message": "Administrador creado; ya puede iniciar sesion"}, 201)
    }
}
