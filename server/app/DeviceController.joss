class DeviceController {
    func provision() {
        $provided = Request::header("X-Provisioning-Key")
        $expected_hash = System::env("PROVISIONING_KEY_HASH", "")
        empty($provided) ? { return ApiResponse::error("Provisioning key requerida", 401) } : {}
        empty($expected_hash) ? { return ApiResponse::error("Provisionamiento deshabilitado", 503) } : {}
        $provided_hash = ClimaSenseTransport::hashToken($provided)
        (ClimaSenseTransport::secureEqual($provided_hash, $expected_hash) == true) ? {} : { return ApiResponse::error("Provisioning key invalida", 401) }

        $device_id = UUID::v4()
        $token = ClimaSenseTransport::randomToken(32)
        $token_hash = ClimaSenseTransport::hashToken($token)
        GranDB::table("devices")->insert({"device_id": $device_id, "name": Request::input("name", "ClimaSense Edge"), "location": Request::input("location", ""), "status": "active", "created_at": System::now(), "updated_at": System::now()})
        GranDB::table("device_credentials")->insert({"device_id": $device_id, "token_hash": $token_hash, "revoked": false, "created_at": System::now()})
        return ApiResponse::json({"device_id": $device_id, "token": $token, "token_notice": "Se muestra una sola vez"}, 201)
    }

    func heartbeat() {
        $payload = Request::all()
        try {
            $device = DeviceAuth::verify($payload)
            GranDB::table("device_heartbeats")->insert({"device_id": $device["device_id"], "firmware_version": Request::input("firmware_version", ""), "runtime_version": Request::input("runtime_version", ""), "health_json": JSON::stringify(Request::input("health", {})), "received_at": System::now()})
            GranDB::table("devices")->where("device_id", $device["device_id"])->update({"last_seen_at": System::now(), "updated_at": System::now()})
            return Response::json({"ok": true})
        } catch ($error) {
            return ApiResponse::error("Autenticacion de dispositivo rechazada", 401)
        }
    }

    func config($device_id) {
        try {
            $device = DeviceAuth::verify(Request::all())
            ($device["device_id"] == $device_id) ? {} : { throw "Dispositivo no autorizado" }
        } catch ($error) {
            return ApiResponse::error("Autenticacion de dispositivo rechazada", 401)
        }
        $row = GranDB::table("device_configurations")->where("device_id", $device_id)->latest("version")->first()
        empty($row) ? { return Response::json({"device_id": $device_id, "config": {}}) } : {}
        return Response::json($row)
    }

    func updates($device_id) {
        try {
            $device = DeviceAuth::verify(Request::all())
            ($device["device_id"] == $device_id) ? {} : { throw "Dispositivo no autorizado" }
        } catch ($error) {
            return ApiResponse::error("Autenticacion de dispositivo rechazada", 401)
        }
        $release = GranDB::table("firmware_releases")->where("channel", Request::input("channel", "stable"))->where("active", true)->latest("created_at")->first()
        empty($release) ? { return Response::json({"update_available": false}) } : {}
        return Response::json({"update_available": true, "release": $release})
    }
}
