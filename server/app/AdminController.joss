class AdminController {
    func index() {
        try { SaaSAuth::requireAdmin() } catch ($error) { return Response::redirect("/login") }
        return View::render("saas.admin", {"title": "Administracion SaaS"})
    }

    func summary() {
        try { SaaSAuth::requireAdmin() } catch ($error) { return ApiResponse::error("Acceso administrador requerido", 401) }
        return ApiResponse::json({
            "metrics": {
                "organizations": GranDB::table("organizations")->count(),
                "locations": GranDB::table("locations")->count(),
                "devices": GranDB::table("devices")->whereNotNull("organization_id")->count(),
                "available_codes": GranDB::table("activation_codes")->where("status", "available")->count(),
                "alerts": GranDB::table("environmental_analyses")->where("severity", "alert")->count()
            },
            "organizations": GranDB::table("organizations")->latest("created_at")->limit(30)->get(),
            "devices": GranDB::table("devices")->latest("updated_at")->limit(30)->get(),
            "analyses": GranDB::table("environmental_analyses")->latest("created_at")->limit(20)->get(),
            "generated_at": System::now()
        }, 200)
    }

    func createOrganization() {
        try { SaaSAuth::requireAdmin() } catch ($error) { return ApiResponse::error("Acceso administrador requerido", 401) }
        $name = Request::input("name", "")
        $slug = Request::input("slug", "")
        $email = Request::input("email", "")
        $password = Request::input("password", "")
        $plan = Request::input("plan", "starter")
        (empty($name) || empty($slug) || empty($email) || empty($password)) ? { return ApiResponse::error("Nombre, slug, correo y contrasena son obligatorios", 422) } : {}
        (GranDB::table("organizations")->where("slug", $slug)->exists() == false) ? {} : { return ApiResponse::error("El identificador de empresa ya existe", 409) }
        (GranDB::table("users")->where("email", $email)->exists() == false) ? {} : { return ApiResponse::error("El correo ya esta registrado", 409) }

        $created = Auth::create({"username": $email, "first_name": $name, "last_name": "", "email": $email, "password": $password, "phone": "", "role_id": 2})
        ($created == false) ? { return ApiResponse::error("No se pudo crear el usuario de empresa", 409) } : {}
        GranDB::table("users")->where("email", $email)->update({"verificado": 1, "updated_at": System::now()})
        $user = GranDB::table("users")->where("email", $email)->first()
        GranDB::table("organizations")->insert({"name": $name, "slug": $slug, "contact_email": $email, "plan": $plan, "status": "active", "created_at": System::now(), "updated_at": System::now()})
        $organization = GranDB::table("organizations")->where("slug", $slug)->first()
        GranDB::table("organization_users")->insert({"organization_id": $organization["id"], "user_id": $user["id"], "organization_role": "owner", "created_at": System::now()})
        LiveUpdate::admin("organization")
        LiveUpdate::user($user["id"], "scope_changed")
        return ApiResponse::json({"ok": true, "organization": $organization, "login_email": $email}, 201)
    }

    func createActivationCode() {
        $admin_id = nil
        try { $admin_id = SaaSAuth::requireAdmin() } catch ($error) { return ApiResponse::error("Acceso administrador requerido", 401) }
        int $organization_id = Request::input("organization_id", 0)
        ($organization_id > 0) ? {} : { return ApiResponse::error("organization_id invalido", 422) }
        $organization = GranDB::table("organizations")->where("id", $organization_id)->where("status", "active")->first()
        empty($organization) ? { return ApiResponse::error("Empresa no encontrada", 404) } : {}
        $code = ClimaSenseTransport::randomToken(16)
        GranDB::table("activation_codes")->insert({
            "organization_id": $organization_id,
            "code_hash": ClimaSenseTransport::hashToken($code),
            "label": Request::input("label", "ClimaSense Edge"),
            "status": "available",
            "created_by_user_id": $admin_id,
            "created_at": System::now()
        })
        LiveUpdate::admin("activation_code")
        LiveUpdate::organization($organization_id, "activation_code")
        return ApiResponse::json({"ok": true, "activation_code": $code, "notice": "Copielo ahora; solo se muestra una vez"}, 201)
    }

    func runAnalysis() {
        try { SaaSAuth::requireAdmin() } catch ($error) { return ApiResponse::error("Acceso administrador requerido", 401) }
        $processed = AnalysisService::runDue()
        return ApiResponse::json({"ok": true, "processed": $processed, "generated_at": System::now()}, 200)
    }
}
