class ActivationController {
    func activate() {
        $code = Request::input("activation_code", "")
        $hardware_id = Request::input("hardware_id", "")
        empty($code) || empty($hardware_id) ? { return ApiResponse::error("Codigo y hardware_id son obligatorios", 422) } : {}
        $record = GranDB::table("activation_codes")->where("code_hash", ClimaSenseTransport::hashToken($code))->where("status", "available")->first()
        empty($record) ? { return ApiResponse::error("Codigo de activacion invalido o utilizado", 401) } : {}
        (GranDB::table("devices")->where("hardware_id", $hardware_id)->exists() == false) ? {} : { return ApiResponse::error("Este equipo ya fue activado", 409) }

        $device_id = UUID::v4()
        $token = ClimaSenseTransport::randomToken(32)
        GranDB::table("devices")->insert({
            "device_id": $device_id,
            "organization_id": $record["organization_id"],
            "hardware_id": $hardware_id,
            "name": Request::input("name", "ClimaSense Edge"),
            "location": "Sin asignar",
            "status": "active",
            "activation_status": "active",
            "created_at": System::now(),
            "updated_at": System::now()
        })
        GranDB::table("device_credentials")->insert({"device_id": $device_id, "token_hash": ClimaSenseTransport::hashToken($token), "revoked": false, "created_at": System::now()})
        GranDB::table("activation_codes")->where("id", $record["id"])->update({"status": "claimed", "claimed_by_device": $device_id, "claimed_at": System::now()})
        return ApiResponse::json({
            "device_id": $device_id,
            "device_token": $token,
            "organization_id": $record["organization_id"],
            "websocket_path": "/ws/edge",
            "message": "Dispositivo activado"
        }, 201)
    }
}
