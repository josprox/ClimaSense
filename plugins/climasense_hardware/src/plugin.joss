class ClimaSenseHardware {
    func ping() {
        return Plugin::call("climasense_hardware", "ping", [])
    }

    func i2cScan(int $bus) {
        return Plugin::call("climasense_hardware", "i2c_scan", [$bus])
    }

    func i2cReadRegister(int $bus, int $address, int $register, int $length, int $timeout_ms) {
        return Plugin::call("climasense_hardware", "i2c_read_register", [$bus, $address, $register, $length, $timeout_ms])
    }

    func i2cWriteRegister(int $bus, int $address, int $register, array $data, int $timeout_ms) {
        return Plugin::call("climasense_hardware", "i2c_write_register", [$bus, $address, $register, $data, $timeout_ms])
    }

    func bmp280Read(int $bus, $address, map $config) {
        return Plugin::call("climasense_hardware", "bmp280_read", [$bus, $address, $config])
    }

    func diagnose(int $bus) {
        return Plugin::call("climasense_hardware", "diagnose", [$bus])
    }
}
