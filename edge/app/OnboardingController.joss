class OnboardingController {
    func index() {
        $server_url = System::env("SERVER_BASE_URL", "http://127.0.0.1:8080")
        return View::render("onboarding", {"server_url": $server_url})
    }

    func setupStatus() {
        $activated = false
        $token_path = System::env("DEVICE_TOKEN_FILE", "/data/climasense/device.token")
        $token = Str::trim(file_get_contents($token_path))
        (empty($token) == false) ? {
            $activated = true
        } : {}

        $ap_ssid = "ClimaSense Mantenimiento"
        $saved_ssid = Str::trim(file_get_contents("/data/climasense/maintenance-ap.ssid"))
        (empty($saved_ssid) == false) ? { $ap_ssid = $saved_ssid } : {}
        $hostapd_config = Str::trim(file_get_contents("/data/climasense/hostapd.conf"))

        return ApiResponse::json({
            "ok": true,
            "activated": $activated,
            "maintenance_ap_configured": empty($hostapd_config) == false,
            "maintenance_ap_ssid": $ap_ssid
        }, 200)
    }

    func scanWifi() {
        $networks = []
        try {
            $output = System::Run("/bin/sh", ["-c", "iwlist wlan0 scan 2>/dev/null | sed -n 's/.*ESSID:\"\\(.*\\)\"/\\1/p'"])
            $lines = explode("\n", $output)
            foreach ($lines as $line) {
                $ssid = Str::trim($line)
                (empty($ssid) == false) ? {
                    $networks = append($networks, {"ssid": $ssid, "signal": "Excelente"})
                } : {}
            }
        } catch ($e) {}

        (count($networks) == 0) ? {
            $networks = [
                {"ssid": "Wi-Fi Oficina Principal", "signal": "Fuerte"},
                {"ssid": "Wi-Fi Servidores", "signal": "Excelente"}
            ]
        } : {}

        return ApiResponse::json({"ok": true, "networks": $networks}, 200)
    }

    func connectWifi() {
        $ssid = Request::input("ssid", "")
        $password = Request::input("password", "")
        (empty($ssid) == true) ? { return ApiResponse::error("El SSID es obligatorio", 422) } : {}
        (Str::length($password) < 8 || Str::length($password) > 63) ? {
            return ApiResponse::error("La contrasena Wi-Fi debe tener entre 8 y 63 caracteres", 422)
        } : {}

        $generated_network = System::Run("wpa_passphrase", [$ssid, $password])
        (empty($generated_network) == true) ? {
            return ApiResponse::error("No se pudo proteger la configuracion Wi-Fi", 500)
        } : {}

        $wpa_conf = "ctrl_interface=/run/wpa_supplicant\nupdate_config=0\ncountry=MX\n\n"
        $network_lines = explode("\n", $generated_network)
        foreach ($network_lines as $network_line) {
            (Str::contains($network_line, "#psk=") == false) ? {
                $wpa_conf = $wpa_conf . $network_line . "\n"
            } : {}
        }
        file_put_contents("/data/climasense/wpa_supplicant.conf", $wpa_conf)
        System::Run("chmod", ["0600", "/data/climasense/wpa_supplicant.conf"])

        return ApiResponse::json({"ok": true, "message": "Wi-Fi guardado. Ingrese ahora el codigo de activacion."}, 200)
    }


    func completeSetup() {
        $code = Request::input("code", "")
        $ap_ssid = Str::trim(Request::input("ap_ssid", ""))
        $ap_pass = Request::input("ap_pass", "")
        $wifi_config = Str::trim(file_get_contents("/data/climasense/wpa_supplicant.conf"))
        (empty($wifi_config) == true) ? {
            return ApiResponse::error("Primero configure la red Wi-Fi", 409)
        } : {}

        $token_path = System::env("DEVICE_TOKEN_FILE", "/data/climasense/device.token")
        $activated = false
        $token = Str::trim(file_get_contents($token_path))
        (empty($token) == false) ? {
            $activated = true
        } : {}

        (empty($ap_ssid) == true) ? {
            $ap_ssid = Str::trim(file_get_contents("/data/climasense/maintenance-ap.ssid"))
        } : {}
        (empty($ap_pass) == true) ? {
            $ap_pass = file_get_contents("/data/climasense/maintenance-ap.pass")
        } : {}

        (empty($ap_ssid) == true) ? { return ApiResponse::error("El nombre del hotspot es obligatorio", 422) } : {}
        (empty($ap_pass) == true) ? { return ApiResponse::error("La contrasena del hotspot es obligatoria", 422) } : {}
        (Str::length($ap_pass) < 8 || Str::length($ap_pass) > 63) ? {
            return ApiResponse::error("La contrasena del hotspot debe tener entre 8 y 63 caracteres", 422)
        } : {}
        (Str::contains($ap_ssid, "\n") || Str::contains($ap_ssid, "\r") || Str::contains($ap_pass, "\n") || Str::contains($ap_pass, "\r")) ? {
            return ApiResponse::error("El nombre y la contrasena no pueden contener saltos de linea", 422)
        } : {}
        ($activated == false && empty($code) == true) ? {
            return ApiResponse::error("El codigo de activacion es obligatorio", 422)
        } : {}

        $hostapd_conf = "interface=wlan0\ndriver=nl80211\ncountry_code=MX\nssid=" . $ap_ssid . "\nhw_mode=g\nchannel=6\nmacaddr_acl=0\nauth_algs=1\nignore_broadcast_ssid=0\nwpa=2\nwpa_passphrase=" . $ap_pass . "\nwpa_key_mgmt=WPA-PSK\nrsn_pairwise=CCMP\n"

        file_put_contents("/data/climasense/hostapd.conf", $hostapd_conf)
        file_put_contents("/data/climasense/maintenance-ap.ssid", $ap_ssid . "\n")
        file_put_contents("/data/climasense/maintenance-ap.pass", $ap_pass)
        System::Run("chmod", ["0600", "/data/climasense/hostapd.conf", "/data/climasense/maintenance-ap.ssid", "/data/climasense/maintenance-ap.pass"])

        ($activated == true) ? {
            file_put_contents("/data/climasense/maintenance.complete", "1\n")
            System::Run("chmod", ["0600", "/data/climasense/maintenance.complete"])
        } : {
            file_put_contents("/data/climasense/activation.code", $code . "\n")
            System::Run("chmod", ["0600", "/data/climasense/activation.code"])
        }

        return ApiResponse::json({
            "ok": true,
            "maintenance": $activated,
            "message": "Configuracion guardada. El hotspot se apagara y el equipo volvera a conectarse."
        }, 202)
    }
}
