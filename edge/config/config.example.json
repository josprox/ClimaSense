{
  "device": {
    "id": "replace-after-provisioning",
    "hardware_id": "replace-after-provisioning",
    "name": "climasense-edge",
    "location": "",
    "token_file": "/data/climasense/device.token",
    "firmware_version": "0.1.0"
  },
  "sensor": {
    "bus": 1,
    "address": "auto",
    "sample_interval_seconds": 30,
    "temperature_oversampling": 1,
    "pressure_oversampling": 4,
    "filter": 2,
    "timeout_ms": 1000,
    "max_retries": 3
  },
  "server": {
    "base_url": "http://climasense.example:8080",
    "activation_path": "/api/v1/edge/activate",
    "websocket_path": "/ws/edge",
    "transport": "websocket",
    "telemetry_path": "/api/v1/telemetry/batch",
    "timeout_seconds": 15,
    "batch_size": 50
  },
  "storage": {
    "database_path": "/data/climasense/edge.sqlite",
    "max_offline_records": 50000
  }
}
