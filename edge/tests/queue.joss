import "src/TelemetryQueue.joss"

$path = "tests/queue-test.sqlite"
TelemetryQueue::initialize($path)
TelemetryQueue::enqueue($path, 1, {"sequence": 1, "temperature_c": 25.0}, 10)
TelemetryQueue::enqueue($path, 2, {"sequence": 2, "temperature_c": 25.5}, 10)
TelemetryQueue::enqueue($path, 2, {"sequence": 2, "temperature_c": 99.0}, 10)

$pending = TelemetryQueue::pending($path, 10)
(count($pending) == 2) ? {} : { throw "La cola no preservo idempotencia" }
($pending[0]["sequence"] == 1) ? {} : { throw "La cola no preservo el orden" }

TelemetryQueue::acknowledge($path, 1)
(TelemetryQueue::count($path) == 1) ? {} : { throw "La confirmacion elimino registros incorrectos" }
print("edge-queue-ok")
