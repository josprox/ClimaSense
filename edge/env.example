DEVICE_NAME="climasense-edge"
DEVICE_LOCATION=""
DEVICE_TOKEN_FILE="/data/climasense/device.token"
DEVICE_FIRMWARE_VERSION="0.2.0"
PORT="8080"
ALLOW_SYSTEM_RUN="true"

SENSOR_BUS="1"
SENSOR_ADDRESS="auto"
SENSOR_SAMPLE_INTERVAL="30"
SENSOR_TEMP_OVERSAMPLING="1"
SENSOR_PRESS_OVERSAMPLING="4"
SENSOR_FILTER="2"
SENSOR_TIMEOUT_MS="1000"
SENSOR_MAX_RETRIES="3"

SERVER_BASE_URL="https://climasense.joss.red"
SERVER_ACTIVATION_PATH="/api/v1/edge/activate"
SERVER_WEBSOCKET_PATH="/ws/edge"
SERVER_TRANSPORT="websocket"
SERVER_TELEMETRY_PATH="/api/v1/telemetry/batch"
SERVER_TIMEOUT_SECONDS="15"
SERVER_BATCH_SIZE="50"

STORAGE_DATABASE_PATH="/data/climasense/edge.sqlite"
STORAGE_MAX_OFFLINE_RECORDS="50000"

PLUGIN_TIMEOUT_SECONDS="20"
