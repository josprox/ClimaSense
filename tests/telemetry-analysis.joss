import "app/ApiResponse.joss"
import "app/LiveUpdate.joss"
import "app/DeviceAuth.joss"
import "app/TelemetryController.joss"
import "app/WeatherService.joss"
import "app/AnalysisService.joss"

$now = System::now()
GranDB::table("organizations")->insert({
    "name": "Context Test",
    "slug": "context-test",
    "contact_email": "context@example.invalid",
    "plan": "starter",
    "status": "active",
    "created_at": $now,
    "updated_at": $now
})
$organization = GranDB::table("organizations")->where("slug", "context-test")->first()

GranDB::table("locations")->insert({
    "organization_id": $organization["id"],
    "name": "Sala de prueba",
    "location_type": "server_room",
    "address": "Prueba local",
    "latitude": 19.4326,
    "longitude": -99.1332,
    "timezone": "America/Mexico_City",
    "desired_min_c": 18,
    "desired_max_c": 24,
    "created_at": $now,
    "updated_at": $now
})
$location = GranDB::table("locations")->where("organization_id", $organization["id"])->first()

GranDB::table("devices")->insert({
    "device_id": "context-test-device",
    "organization_id": $organization["id"],
    "location_id": $location["id"],
    "hardware_id": "context-test-hardware",
    "name": "Context Edge",
    "location": $location["name"],
    "status": "active",
    "activation_status": "active",
    "created_at": $now,
    "updated_at": $now
})
GranDB::table("device_credentials")->insert({
    "device_id": "context-test-device",
    "token_hash": ClimaSenseTransport::hashToken("context-test-device-token-2026"),
    "revoked": false,
    "created_at": $now
})

GranDB::table("weather_snapshots")->insert({
    "organization_id": $organization["id"],
    "location_id": $location["id"],
    "temperature_c": 20,
    "apparent_temperature_c": 20,
    "relative_humidity": 50,
    "surface_pressure_hpa": 1012,
    "source": "test-cache",
    "observed_at": $now,
    "created_at": $now
})

$result = TelemetryController::storeBatchPayload({
    "measurements": [{
        "schema_version": 1,
        "device_id": "context-test-device",
        "sequence": 1,
        "measured_at": $now,
        "temperature_c": 28.5,
        "pressure_pa": 101200,
        "pressure_hpa": 1012,
        "sensor_type": "bmp280",
        "sensor_address": "0x76",
        "sensor_status": "ok",
        "firmware_version": "test",
        "runtime_version": JOSS_VERSION
    }]
}, "context-test-device")

($result["accepted"] == 1) ? {} : { throw "El lote no fue almacenado" }
$device = GranDB::table("devices")->where("device_id", "context-test-device")->first()
$last_seen_at = $device["last_seen_at"]
(empty($last_seen_at) == false) ? {} : { throw "No se registro last_seen_at" }

$processed = AnalysisService::runDue()
($processed == 1) ? {} : { throw "El analisis contextual no proceso el dispositivo" }
$analysis = GranDB::table("environmental_analyses")->where("device_id", "context-test-device")->first()
empty($analysis) ? { throw "No se almaceno el analisis contextual" } : {}
($analysis["location_id"] == $location["id"]) ? {} : { throw "El analisis no uso la ubicacion asignada" }
($analysis["severity"] == "alert") ? {} : { throw "La temperatura fuera de rango no genero alerta" }

$reprocessed = AnalysisService::runDue()
($reprocessed == 0) ? {} : { throw "Se duplico el analisis sin telemetria nueva" }

print("server-telemetry-analysis-ok")
