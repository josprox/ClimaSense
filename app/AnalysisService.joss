class AnalysisService {
    func runForever() {
        $interval = 600
        try {
            $configured_interval = JSON::parse(System::env("ANALYSIS_INTERVAL_SECONDS", "600"))
            ($configured_interval >= 60) ? { $interval = $configured_interval } : {}
        } catch ($configuration_error) {}
        System::log("Trabajador ambiental activo; intervalo=" . $interval . " segundos")
        while (true) {
            AnalysisService::runDue()
            System::sleep($interval)
        }
    }

    func recommendation($location, $average, $outdoor, string $severity) {
        $type = $location["location_type"]
        ($severity == "ok") ? { return "El ambiente permanece dentro del rango configurado. Mantenga la operacion y continue observando la tendencia." } : {}
        ($average > $location["desired_max_c"]) ? {
            ($type == "server_room") ? { return "Temperatura alta en sala de servidores. Revise aire acondicionado, flujo de aire, filtros, puertas y carga termica; no apague equipos sin seguir el procedimiento operativo." } : {}
            ($outdoor != nil && $outdoor < $average) ? { return "La temperatura interior supera el objetivo y el exterior es mas fresco. Considere ventilacion controlada y revise fuentes internas de calor." } : {}
            return "La temperatura interior supera el objetivo. Revise ventilacion, climatizacion y fuentes de calor antes de que la desviacion aumente."
        } : {}
        return "La temperatura esta por debajo del rango objetivo. Revise calefaccion, corrientes de aire y la ubicacion fisica del sensor."
    }

    func analyzeDevice($device) {
        $location = GranDB::table("locations")->where("id", $device["location_id"])->where("organization_id", $device["organization_id"])->first()
        empty($location) ? { return false } : {}
        $sample_query = GranDB::table("telemetry_measurements")->where("device_id", $device["device_id"])
        $previous = GranDB::table("environmental_analyses")->where("device_id", $device["device_id"])->latest("window_ended_at")->first()
        empty($previous) ? {} : { $sample_query = $sample_query->where("received_at", ">", $previous["window_ended_at"]) }
        $samples = $sample_query->latest("measured_at")->limit(20)->get()
        (count($samples) > 0) ? {} : { return false }
        float $sum = 0.0
        float $minimum = 999.0
        float $maximum = -999.0
        float $desired_min = $location["desired_min_c"]
        float $desired_max = $location["desired_max_c"]
        foreach ($samples as $sample) {
            float $temperature = 0.0
            $temperature = $sample["temperature_c"]
            $sum = $sum + $temperature
            ($temperature < $minimum) ? { $minimum = $temperature } : {}
            ($temperature > $maximum) ? { $maximum = $temperature } : {}
        }
        float $average = $sum / count($samples)
        $outdoor = nil
        try {
            $weather = WeatherService::current($location)
            float $outdoor_temp = $weather["temperature_c"]
            $outdoor = $outdoor_temp
        } catch ($weather_error) {
            $latest_weather = GranDB::table("weather_snapshots")->where("location_id", $location["id"])->latest("observed_at")->first()
            empty($latest_weather) ? {} : {
                float $outdoor_snap = $latest_weather["temperature_c"]
                $outdoor = $outdoor_snap
            }
        }

        $verdict = "optimal"
        $severity = "ok"
        ($average > $desired_max) ? { $verdict = "high"; $severity = "alert" } : {}
        ($average < $desired_min) ? { $verdict = "low"; $severity = "alert" } : {}
        ($severity == "ok" && ($average - $desired_min < 1.0 || $desired_max - $average < 1.0)) ? { $verdict = "near_limit"; $severity = "warning" } : {}
        $recommendation = AnalysisService::recommendation($location, $average, $outdoor, $severity)
        $analyzed_at = System::now()
        GranDB::table("environmental_analyses")->insert({
            "organization_id": $device["organization_id"],
            "location_id": $location["id"],
            "device_id": $device["device_id"],
            "sample_count": count($samples),
            "indoor_avg_c": $average,
            "indoor_min_c": $minimum,
            "indoor_max_c": $maximum,
            "outdoor_c": $outdoor,
            "verdict": $verdict,
            "severity": $severity,
            "recommendation": $recommendation,
            "analysis_model": "climasense-context-v1",
            "window_ended_at": $analyzed_at,
            "created_at": $analyzed_at
        })
        $cutoff = GranDB::table("telemetry_measurements")->where("device_id", $device["device_id"])->latest("measured_at")->offset(100)->first()
        (empty($cutoff) == false) ? {
            GranDB::table("telemetry_measurements")->where("device_id", $device["device_id"])->where("measured_at", "<=", $cutoff["measured_at"])->delete()
        } : {}
        LiveUpdate::admin("analysis")
        LiveUpdate::organization($device["organization_id"], "analysis")
        return true
    }

    func runDue() {
        try {
            $devices = GranDB::table("devices")->where("status", "active")->whereNotNull("organization_id")->whereNotNull("location_id")->get()
            $processed = 0
            foreach ($devices as $device) {
                $analyzed = AnalysisService::analyzeDevice($device)
                ($analyzed == true) ? { $processed = $processed + 1 } : {}
            }
            System::log("Analisis ambiental SaaS completado")
            return $processed
        } catch ($error) {
            System::log("Analisis ambiental omitido: " . $error)
            return 0
        }
    }
}
