class OperatorAuth {
    func verify() {
        $token = Request::header("X-Operator-Token")
        $expected = System::env("OPERATOR_TOKEN_HASH", "")
        empty($token) ? { throw "Token operador requerido" } : {}
        empty($expected) ? { throw "Acceso operador deshabilitado" } : {}
        $provided = ClimaSenseTransport::hashToken($token)
        (ClimaSenseTransport::secureEqual($provided, $expected) == true) ? { return true } : { throw "Token operador invalido" }
    }
}
