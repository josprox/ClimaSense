class WeatherService {
    func current($location) {
        float $lat = $location["latitude"]
        float $lon = $location["longitude"]
        $weather = ClimaSenseTransport::weatherCurrent($lat, $lon, 10)
        GranDB::table("weather_snapshots")->insert({
            "organization_id": $location["organization_id"],
            "location_id": $location["id"],
            "temperature_c": $weather["temperature_c"],
            "apparent_temperature_c": $weather["apparent_temperature_c"],
            "relative_humidity": $weather["relative_humidity"],
            "surface_pressure_hpa": $weather["surface_pressure_hpa"],
            "source": $weather["source"],
            "observed_at": $weather["observed_at"],
            "created_at": System::now()
        })
        return $weather
    }
}
