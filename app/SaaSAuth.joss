class SaaSAuth {
    func userId() {
        (Auth::check() == true) ? { return Auth::id() } : { throw "Sesion requerida" }
    }

    func requireAdmin() {
        $user_id = SaaSAuth::userId()
        (Auth::hasRole("admin") == true) ? { return $user_id } : { throw "Administrador requerido" }
    }

    func findMembership() {
        $user_id = SaaSAuth::userId()
        return GranDB::table("organization_users")->where("user_id", $user_id)->first()
    }

    func membership() {
        $membership = SaaSAuth::findMembership()
        empty($membership) ? { throw "El usuario no pertenece a una empresa" } : {}
        return $membership
    }

    func organizationId() {
        $membership = SaaSAuth::membership()
        return $membership["organization_id"]
    }
}
